# Copy to `.env` and adjust. Used by docker-compose; the backend reads the
# DE_* variables, the frontend build reads the VITE_* ones.

# --- Database -----------------------------------------------------------
POSTGRES_USER=donde
POSTGRES_PASSWORD=change-me
POSTGRES_DB=donde_estoy

# --- Backend ------------------------------------------------------------
# Public URL where people open the app; share links are built from it.
DE_PUBLIC_URL=http://localhost:8080
# Browser origins allowed to call the API (comma separated).
DE_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Session lifetime (hours) and how long a link survives after arrival (minutes).
DE_DEFAULT_SESSION_HOURS=8
DE_MAX_SESSION_HOURS=24
DE_FINISHED_GRACE_MINUTES=60
# Sessions one IP may create per hour (0 = unlimited).
DE_CREATE_RATE_LIMIT_PER_HOUR=30

# --- Frontend (build time) ------------------------------------------------
# Raster tile template and attribution. The default is OpenTopoMap, which is
# fine for personal / low-traffic use. For anything bigger, use your own tile
# provider (see README > Map tiles).
VITE_TILE_URL=https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png
VITE_TILE_MAX_ZOOM=17
